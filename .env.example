# ==========================================
# SyncBox Environment Configuration
# ==========================================

# ==========================================
# Database Configuration (Supabase or Local)
# ==========================================
# For Local Docker PostgreSQL:
# DB_USER=postgres
# DB_PASSWORD=9265944501
# DB_NAME=syncbox

# For Supabase Cloud PostgreSQL:
# 1. Host is your project's connection pooler in ap-southeast-1 (Singapore):
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# 2. Username for Supabase pooler: postgres.[YOUR-PROJECT-REF]
DB_USER=postgres.orgmmfslndbfrchcnjab
# 3. Your Supabase Database Password (the password you created when creating the Supabase project)
DB_PASSWORD=your_supabase_database_password_here

# Storage Provider: "b2" (Backblaze B2 Cloud Storage) or "local" (Local Disk Storage)
STORAGE_PROVIDER=b2

# ==========================================
# Backblaze B2 Cloud Storage Credentials
# ==========================================
# 1. B2_KEY_ID: Your Backblaze Application Key ID (keyID)
B2_KEY_ID=your_backblaze_key_id_here

# 2. B2_APPLICATION_KEY: Your Backblaze Application Key (secret key)
B2_APPLICATION_KEY=your_backblaze_application_key_here

# 3. B2_BUCKET_NAME: Your Backblaze B2 Bucket Name
B2_BUCKET_NAME=your_backblaze_bucket_name_here

# 4. B2_ENDPOINT: S3 Endpoint URL from your Backblaze Bucket Details
# Example: https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# 5. B2_REGION: Region matching your endpoint (e.g., us-west-004, us-east-005, eu-central-003)
B2_REGION=us-west-004
